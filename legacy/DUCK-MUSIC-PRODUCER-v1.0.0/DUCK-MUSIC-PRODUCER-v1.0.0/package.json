{
  "name": "duck-music-producer",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "duck:api": "tsx server/duck/api-cli.ts",
    "duck:start": "NODE_ENV=production node dist-duck/api-cli.js",
    "duck": "tsx server/duck/cli.ts",
    "duck:worker": "tsx server/duck/worker.ts",
    "duck:worker:once": "tsx server/duck/worker.ts --once",
    "duck:build": "esbuild server/duck/api-cli.ts server/duck/cli.ts server/duck/worker.ts --platform=node --packages=external --bundle --format=esm --outdir=dist-duck",
    "build": "pnpm duck:build",
    "start": "pnpm duck:start",
    "check": "tsc --noEmit -p tsconfig.duck.json",
    "test": "vitest run server/duck/core.test.ts",
    "license-report": "node scripts/generate-license-report.mjs",
    "verify:runtime": "node scripts/verify-duck-runtime.mjs"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.1",
    "express": "^4.21.2",
    "p-limit": "^7.3.1",
    "playwright": "^1.62.1",
    "yaml": "^2.9.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^2.1.4"
  }
}
